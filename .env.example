# Secret de l'intégration Notion (lecture seule) — obligatoire en production
NOTION_TOKEN=
# URL canonique du site, sans slash final
NEXT_PUBLIC_SITE_URL=https://osteopathe-tchikaya.lu
# Secret de /api/revalidate?secret=… (chaîne aléatoire longue)
REVALIDATE_SECRET=
# Optionnel : forcer l'indexation hors production Vercel (tests Lighthouse SEO en local)
ALLOW_INDEXING=
# Optionnel : balise de vérification Search Console (si pas de vérification DNS)
GOOGLE_SITE_VERIFICATION=
# Optionnel : activer Vercel Web Analytics + Speed Insights (après activation dans le dashboard)
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=
# Optionnel : note Google automatique (API Google Places « New », champs rating + userRatingCount).
# Clé serveur uniquement (jamais NEXT_PUBLIC_), restreinte à « Places API (New) ». Sans ces deux
# variables, le site utilise Note_Google / Nombre_Avis_Google de Notion (ou masque la note).
GOOGLE_PLACES_API_KEY=
# Identifiant de la fiche Google du cabinet (Place ID, commence souvent par « ChIJ »)
GOOGLE_PLACE_ID=
# Optionnel : ID de conteneur Google Tag Manager (ex. GTM-XXXXXXX). Chargé uniquement après consentement
# (bannière cookies) : laisser vide désactive entièrement la fonctionnalité, sans bannière.
NEXT_PUBLIC_GTM_ID=
# Secret de /admin/photos (outil temporaire d'upload vers Vercel Blob) — à retirer une fois les
# vraies photos collées dans Notion (supprimer aussi src/app/admin et src/app/api/admin)
ADMIN_UPLOAD_SECRET=
